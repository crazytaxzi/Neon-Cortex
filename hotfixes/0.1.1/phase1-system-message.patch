+    @staticmethod
+    def _expanded_path(value: object) -> Path:
+        raw = str(value or "").strip()
+        if not raw:
+            return Path()
+        return Path(os.path.expandvars(os.path.expanduser(raw)))
+
+    def _candidate_roots(self) -> list[Path]:
+        roots = [BASE_DIR]
+        local_appdata = os.environ.get("LOCALAPPDATA")
+        if local_appdata:
+            installed = Path(local_appdata) / "Cinder_Alpha"
+            if installed not in roots:
+                roots.append(installed)
+        return roots
+
+    def _resolve_runtime_file(self, config_key: str, patterns: tuple[str, ...]) -> Path:
+        configured = self._expanded_path(self.config_data.get(config_key, ""))
+        if configured.is_file():
+            return configured
+
+        for root in self._candidate_roots():
+            for pattern in patterns:
+                matches = sorted(root.glob(pattern), key=lambda item: item.stat().st_mtime, reverse=True)
+                if matches:
+                    return matches[0]
+        return configured
+
